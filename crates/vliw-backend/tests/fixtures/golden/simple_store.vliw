.processor {
  width 4

  hardware {
    unit alu = integer_alu
    unit mem = memory
    unit ctrl = control
    unit mul = multiplier
  }

  layout slots {
    alias I0 = 0
    alias I1 = 1
    alias M = 2
    alias X = 3

    0 = { alu }
    1 = { alu }
    2 = { mem }
    3 = { ctrl, mul }
  }

  cache { }
  topology { cpus 1 }
}

main:
entry:
{
  I0: movi r2, 42
  I1: nop
  M : nop
  X : nop
}
{
  I0: nop
  I1: nop
  M : std [r0 + 0x100], r2
  X : nop
}
{
  I0: movi r1, 0
  I1: nop
  M : nop
  X : nop
}
{
  I0: nop
  I1: nop
  M : nop
  X : ret
}
